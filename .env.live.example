# Copy this file to .env.live (gitignored), fill in at least one provider key,
# then run:
#
#     python scripts/live_key_test.py
#
# The script reads this file, stores each key in the encrypted vault under
# .evalh-live/, and runs two cheap cases. It never prints a key and never puts
# one in the spec or in a command line.
#
# The master key is generated on the first run and written back here. Back it
# up: losing it means re-entering every provider key.

OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_INPUT_PRICE=
# OPENAI_OUTPUT_PRICE=

ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-4-5
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# The Anthropic adapter appends /v1/messages; do not add /v1 here.
# ANTHROPIC_INPUT_PRICE=
# ANTHROPIC_OUTPUT_PRICE=

# Generated on the first run when this is blank.
EVALH_MASTER_KEY=
