# Keep the build context small and keep secrets out of the image.
.git
.gitignore
.github
.pytest_cache
.ruff_cache
.venv
.test-work
.tmp-probe
__pycache__/
*.py[cod]
*.db
*.sqlite3
*.log
artifacts/
coverage.xml
htmlcov/
dist/
build/
*.egg-info/
.env
.env.*
!.env.example
# Tests and design notes are not part of the runtime image.
tests/
docs/
wt/
