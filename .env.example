# Copy this file to .env and fill in the values. .env is gitignored and must
# never be committed. No value here is a real secret.
#
# First start, before a key exists:
#   docker compose up harness
# The harness prints a line like "EVALH_MASTER_KEY=<44 urlsafe base64 chars>"
# and exits 2. Paste that value below, then start the stack for real:
#   docker compose up -d
EVALH_MASTER_KEY=

# The database password. Generate one and keep it only in .env:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Compose refuses to start when this is empty, so there is no default secret.
EVALH_POSTGRES_PASSWORD=
EVALH_POSTGRES_USER=evalh
EVALH_POSTGRES_DB=evalh

# Host port for the console. Change it when 8000 is already in use.
EVALH_PORT=8000
